load("//:defs.bzl", "maplecode_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:runtime_package.bzl", "release_binary")

maplecode_rust_crate(
    name = "exec-server-cli",
    binaries_with_build_commit = ["maplecode-exec-server"],
    crate_name = "maplecode_exec_server_cli",
    extra_binaries = ["//maplecode-rs/bwrap:bwrap"],
    test_data_extra = glob(["src/**/snapshots/**"]),
    # The standalone integration test launches native OS sandboxes itself.
    test_tags = ["no-sandbox"],
)

release_binary(binary = ":maplecode-exec-server")

multiplatform_binaries(name = "maplecode-exec-server")
